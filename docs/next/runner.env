# claude-phase-runner config for the launch-completion batch.
# Run from the kit:  bash run.sh /home/alex/work/better-base/docs/next/runner.env
# Dry run first:     DRY_RUN=1 bash run.sh /home/alex/work/better-base/docs/next/runner.env
# Preflight:         bash run.sh preflight /home/alex/work/better-base/docs/next/runner.env
PROJECT_DIR=/home/alex/work/better-base
ENTRY_FILE=docs/next/NEXT-PROMPT.md
PHASE_FILES="docs/next/NEXT-1-NEON-PROOF.md docs/next/NEXT-2-DEPLOY-PIPELINE.md docs/next/NEXT-3-SETTINGS.md docs/next/NEXT-4-LEGAL-ANALYTICS.md docs/next/NEXT-5-ORDER-LIFECYCLE.md docs/next/NEXT-6-INVOICE-DATA.md docs/next/NEXT-7-INVOICE-DOCUMENT.md docs/next/NEXT-8-SHIPPING.md docs/next/NEXT-9-NURTURE.md docs/next/NEXT-10-POLISH.md"
RETRY_SCHEDULE="30 300 3600 10800"
# Invoice/shipping phases build + run e2e in one silent tool call; 40min was
# already the tuned value for this repo, keep it.
STALL_TIMEOUT=2400
GATE_CMD="pnpm lint && pnpm check && pnpm test:unit"
PUSH=1
GIT_REMOTE=origin
# The batch starts on the Vercel/Neon branch (phases 1-2 finish it). Push the
# branch before launching: git push -u origin feat/vercel-neon
GIT_BRANCH=feat/vercel-neon
CLAUDE_MODEL=claude-fable-5
