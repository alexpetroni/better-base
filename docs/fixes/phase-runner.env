# claude-phase-runner (per-project layout) — remediation batch 2, docs/AUDIT-2026-09-03.md
# Copy to .phase-runner/runner.env (that directory is git-excluded); the phases manifest
# next to this file goes to .phase-runner/phases. Then:
#   phase-runner build --dry-run   # prints the exact first builder prompt
#   phase-runner preflight         # what tooling/credentials the plan needs
#   phase-runner build             # go (tmux; Ctrl-C is safe)
ENTRY_FILE=docs/fixes/FIX-PROMPT-2026-09.md
GATE_CMD="pnpm lint && pnpm check && pnpm test:unit"

PHASE_REVIEW=1
MAX_FIX_ROUNDS=2
# Keep the verdicts in the repo next to the audit they close.
COMMIT_REVIEWS=1
REVIEWS_DIR=docs/verification

# Builder and reviewer: same model; a stronger judge than the builder is cheap, so if the
# builder is ever downgraded keep REVIEW_MODEL on the top model.
CLAUDE_MODEL=claude-fable-5-1
REVIEW_EFFORT=high
# Real runs in this repo cost $4–48 per phase; FIX-12 and FIX-16 are the large ones.
BUILD_BUDGET_USD=60
REVIEW_BUDGET_USD=15

RETRY_SCHEDULE="30 300 3600 10800"
# Several phases build + run e2e in one silent tool call; 40 min was the tuned value.
STALL_TIMEOUT=2400

PUSH=1
GIT_REMOTE=origin
# The batch continues on the unmerged launch branch; merge to main only after FIX-16 has
# put the CI gate in front of the migrate workflow (audit P0 #5).
GIT_BRANCH=feat/vercel-neon

# Chromium libs for the e2e deliverables (FIX-9, FIX-15), fonts for Romanian diacritics,
# xmllint for offline UBL checks (FIX-12), psql for the schema phases, zip for exports.
EXTRA_APT_PACKAGES="libnss3 libnspr4 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 libdbus-1-3 libxkbcommon0 libatspi2.0-0 libx11-6 libx11-xcb1 libxcb1 libxcomposite1 libxdamage1 libxext6 libxfixes3 libxrandr2 libgbm1 libpango-1.0-0 libcairo2 libasound2 libxshmfence1 libglib2.0-0 fonts-liberation fonts-dejavu-core fonts-noto-core libxml2-utils postgresql-client zip"
