# Copy to .env and adjust. The compose-service URLs below (DATABASE_URL,
# TEST_DATABASE_URL, S3_ENDPOINT, MEDIA_PUBLIC_BASE_URL) are written for the host, but
# you do NOT need to edit them for a containerized runner: tooling rewrites
# those four hostnames at load time to whatever reaches the docker host from
# the current process — `localhost` on the host, `host.docker.internal` from a
# sibling container (apps/web/src/lib/config/hosts.ts). Everything else,
# including PUBLIC_SITE_URL, is used verbatim.

# Which site this deployment is: `sleep` | `life`. Selects the site config.
SITE_ID=sleep

# Postgres connection for the active site. One database per site:
#   sleep -> better_sleep, life -> better_life (both created by docker compose).
# For SITE_ID=life use: postgres://better:better@localhost:5433/better_life
DATABASE_URL=postgres://better:better@localhost:5433/better_sleep

# Dedicated database for integration tests; dropped and re-migrated per test run.
TEST_DATABASE_URL=postgres://better:better@localhost:5433/better_test

# Postgres driver: `pg` (default — a real pool, for the long-lived node server)
# or `neon` (serverless WebSocket driver, for Vercel functions). See DEPLOYMENT.md §12.
#DB_DRIVER=neon

# Migrations only: an UNPOOLED connection for DDL. Set it on Neon (the pooled
# endpoint runs PgBouncer); elsewhere leave it unset and DATABASE_URL is used.
#DIRECT_DATABASE_URL=postgres://…neon.tech/better_sleep?sslmode=require

# Local Neon-protocol proxy (dev/tests only — see DEPLOYMENT.md §12): with the
# neon driver, dial this ws:// proxy instead of deriving wss:// from the
# connection string. `pnpm test:neon` sets it; the proxy comes from
# `docker compose --profile neon up -d --build`. NEVER set against real Neon.
#NEON_WS_PROXY=localhost:5488
# Postgres address the proxy dials, as seen from the proxy's own network
# (default: the compose `db` service — must match its ALLOW_ADDR_REGEX).
#NEON_WS_PROXY_TARGET=db:5432
# Host port docker compose publishes the neon proxy on (container port 80).
#NEON_WS_PROXY_PORT=5488

# Deployment target for the build: `node` (default) or `vercel`. Vercel sets
# VERCEL=1 itself — this only exists to produce either output locally.
#DEPLOY_TARGET=vercel

# Guards GET /api/cron/chat-prune, the retention job for deploys with no cron
# machine (Vercel sends it as `Authorization: Bearer …`). openssl rand -hex 32.
#CRON_SECRET=

# Public origin of this deployment.
PUBLIC_SITE_URL=http://localhost:5173

# Host port that docker compose publishes Postgres on (container port is 5432).
DB_PORT=5433

# --- DB pool bounds & timeouts ----------------------------------------------
# All optional; the values below are the built-in defaults. They exist so a
# few hung requests can never hold connections forever and starve the app.
# Upper bound on open connections per process.
#DB_POOL_MAX=10
# How long a request waits for a free connection before failing (shed load).
#DB_POOL_CONNECTION_TIMEOUT_MS=5000
# Idle connections are closed after this.
#DB_POOL_IDLE_TIMEOUT_MS=30000
# Server-side statement_timeout: Postgres cancels any query running longer.
#DB_STATEMENT_TIMEOUT_MS=30000

# Secret for better-auth session signing/hashing. Generate a long random value
# for anything beyond local dev (e.g. `openssl rand -base64 32`).
BETTER_AUTH_SECRET=dev-only-secret-change-me-0123456789

# Dedicated secret for app-signed tokens (newsletter confirm links, chat
# session cookies, upload-confirm tickets). MUST differ from
# BETTER_AUTH_SECRET — the app refuses to boot when they match, so one leaked
# secret never compromises both. Generate: `openssl rand -base64 32`.
# Rotating it invalidates outstanding confirm links and chat sessions.
TOKEN_SECRET=dev-only-token-secret-change-me-9876543210

# --- Media storage (S3-compatible) ---------------------------------------
# Dev: MinIO from docker compose. Prod: Cloudflare R2 — same variables, no
# code changes (endpoint, creds and bucket all come from here).
# The endpoint must be reachable BOTH by the server (presign/confirm/delete)
# and by the browser (it PUTs directly to the presigned URL).
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=better-media
S3_SECRET_KEY=better-media-secret
S3_BUCKET=better-base-media
S3_REGION=us-east-1

# Host ports docker compose publishes MinIO on (API / web console).
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Image delivery ------------------------------------------------------
# Which provider builds the <img> URLs (DEPLOYMENT.md §6). Unset = `direct`.
#
#   direct      the stored original, untouched. Local dev + the test suite:
#               no transformer container to run, no signing key to manage.
#               launch:check REFUSES it on a real deploy — visitors would get
#               full-size photos.
#   cloudflare  Cloudflare Image Transformations (/cdn-cgi/image) in front of
#               the public R2 origin. The production default: nothing of ours
#               stays always-on, so Vercel + Neon + Cloudflare is the whole
#               deployment.
#   imgproxy    the signed self-hosted transformer, for the VPS target. Needs
#               `docker compose --profile imgproxy up -d` locally.
IMAGE_PROVIDER=direct

# Public origin serving the stored ORIGINALS.
#   dev:  leave empty — it is derived from S3_ENDPOINT + S3_BUCKET (MinIO is
#         path-style), so a stock checkout needs no value here. `pnpm
#         storage:init` applies the anonymous-read policy the browser needs.
#   prod: the R2 bucket's Cloudflare custom domain, e.g.
#         https://media.bettersleep.ro — created in the R2 dashboard, not by
#         any script. Must be https.
MEDIA_PUBLIC_BASE_URL=

# Zone that serves /cdn-cgi/image (IMAGE_PROVIDER=cloudflare only). Defaults to
# PUBLIC_SITE_URL, which is right whenever the site and the media bucket share
# one Cloudflare zone. Set it only when they do not.
CF_IMAGE_BASE_URL=

# --- imgproxy (IMAGE_PROVIDER=imgproxy only) -------------------------------
# Everything below is unused unless IMAGE_PROVIDER=imgproxy. The container is
# behind a compose profile: `docker compose --profile imgproxy up -d`.
# Public base URL the app embeds in <img> tags (browser-reachable).
IMGPROXY_URL=http://localhost:8888
# Hex-encoded HMAC key/salt that sign every imgproxy URL. NO committed
# defaults on purpose: generate your own pair, even for local dev —
#   openssl rand -hex 32   (run twice: once for the key, once for the salt)
# docker compose passes these same values to the imgproxy container and
# refuses to start while they are missing; the app refuses to boot too.
# Rotation: deploy new values to imgproxy and the app together (see
# DEPLOYMENT.md §6 — pages sign URLs per request, so a joint restart is safe).
IMGPROXY_KEY=
IMGPROXY_SALT=
# Host port docker compose publishes imgproxy on (container port 8080).
IMGPROXY_PORT=8888

# --- Stripe (shop) ----------------------------------------------------------
# Leave STRIPE_SECRET_KEY empty to run on the deterministic in-memory MOCK
# gateway (dev default; all tests run on the mock). Set a TEST key
# (sk_test_…) for a real end-to-end manual check — never a live key in dev.
STRIPE_SECRET_KEY=
# Webhook signing secret: from the Stripe dashboard endpoint config, or the
# one `stripe listen` prints. Any non-empty value works for the mock/dev flow.
STRIPE_WEBHOOK_SECRET=whsec_dev_only_secret_change_me
# Per-request cap on Stripe API calls (ms); default below. Retries are bounded
# in code (2, with idempotency keys), so a hung socket fails fast and handled.
#STRIPE_TIMEOUT_MS=20000

# --- Courier (shipping) ------------------------------------------------------
# `mock` (default) is a deterministic in-memory courier — dev and ALL tests
# run on the mock; no test can ever call a courier API. `sameday` uses the
# Sameday REST API and then REQUIRES the three SAMEDAY_* values at boot (the
# server refuses to start on a half-set config). Ambient SAMEDAY_* credentials
# alone never activate the live adapter. Account setup: LAUNCH-CHECKLIST.md.
COURIER_PROVIDER=mock
SAMEDAY_USERNAME=
SAMEDAY_PASSWORD=
# Sameday pickup-point id of the warehouse parcels leave from (from the
# eAWB dashboard / GET /api/client/pickup-points).
SAMEDAY_PICKUP_POINT=
# Optional overrides; defaults below. Service 7 = standard 24h delivery.
#SAMEDAY_BASE_URL=https://api.sameday.ro
#SAMEDAY_SERVICE_ID=7
#SAMEDAY_TIMEOUT_MS=15000

# --- Email (Resend) --------------------------------------------------------
# Dry-run is the DEFAULT: emails are recorded in the email_log table instead
# of being sent. Real delivery requires EMAIL_DRYRUN=false AND a Resend key.
# Tests always run dry — never point a test environment at a real key.
EMAIL_DRYRUN=true
RESEND_API_KEY=
# Per-call cap on the Resend API (ms); default below. A hung send becomes a
# retryable `error` row in email_log instead of pinning the request.
#RESEND_TIMEOUT_MS=10000

# --- Chat (assistant) --------------------------------------------------------
# `mock` (default) answers with deterministic canned ro replies — dev and ALL
# tests run on the mock. `anthropic` streams from the Anthropic API and then
# REQUIRES ANTHROPIC_API_KEY at boot (the server refuses to start without it).
# The key is never required in dev or tests.
CHAT_PROVIDER=mock
ANTHROPIC_API_KEY=
# Cap on time-to-response for one Anthropic call (ms); default below. Applies
# to reaching the API, not the duration of a healthy stream.
#ANTHROPIC_TIMEOUT_MS=60000

# --- Analytics (optional) ----------------------------------------------------
# No-op by default: with these unset, NO analytics script ships. Set all three
# to enable a privacy-friendly provider; the script is injected client-side
# ONLY after the visitor grants cookie consent, and never on /admin routes.
# PUBLIC_ because the client injects the script — no secrets belong here.
#   PUBLIC_ANALYTICS_PROVIDER  "plausible" or "umami"
#   PUBLIC_ANALYTICS_HOST      service origin, e.g. https://plausible.io or a
#                              self-hosted instance
#   PUBLIC_ANALYTICS_SITE_ID   Plausible data-domain (bettersleep.ro) or the
#                              Umami website id
#PUBLIC_ANALYTICS_PROVIDER=plausible
#PUBLIC_ANALYTICS_HOST=https://plausible.io
#PUBLIC_ANALYTICS_SITE_ID=bettersleep.ro

# --- Reverse proxy (prod only) ----------------------------------------------
# Behind a proxy, rate limits key on the proxy's IP unless adapter-node is
# told which header carries the real client address. Set ONLY per the
# deployment topology — a wrong value makes rate-limit keys spoofable.
# See DEPLOYMENT.md §3 ("Client IPs behind the proxy").
#ADDRESS_HEADER=x-forwarded-for
#XFF_DEPTH=1

# --- e-Factura (ANAF SPV) ---------------------------------------------------
# Invoice PDFs + CIUS-RO XMLs are always generated and stored; SUBMISSION to
# ANAF is not implemented (needs a qualified certificate + SPV enrollment —
# DEPLOYMENT.md §7 "Fiscal documents"). Setting this flag before the adapter
# exists is a deliberate boot error; leave it unset.
#ANAF_EFACTURA_ENABLED=true
